## docker base images（基础镜像源）
## runner/内网主机按实际可达性配置（2026-09-07 ubuntu24 实测：docker.1ms.run 可达，
## dockerproxy.net 解析 Fake-IP 不可达，docker.m.daocloud.io 超时）。
## 镜像名保持官方 library/ 路径，仅切换源主机。
## GitLab CI/CD Variables 可进一步覆盖本文件的值。
DOCKER_REGISTRY_MIRROR=docker.1ms.run
#MAVEN_IMAGE=library/maven:3.9.9-eclipse-temurin-21
#JRE_IMAGE=library/eclipse-temurin:21-jre
#NODE_IMAGE=library/node:20-alpine
#NGINX_IMAGE=library/nginx:1.24-alpine

## mysql
MYSQL_DATABASE=weitee-erp
MYSQL_ROOT_PASSWORD=123456

## server
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

MASTER_DATASOURCE_URL=jdbc:mysql://weitee-mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}
REDIS_HOST=weitee-redis

## admin
NODE_ENV=production
NPM_REGISTRY=https://registry.npmmirror.com
PNPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR=https://maven.aliyun.com/repository/public
PUBLIC_PATH=/
VUE_APP_TITLE=微泰ERP管理系统
VUE_APP_BASE_API=/prod-api
VUE_APP_APP_NAME=/
VUE_APP_CAPTCHA_ENABLE=false
VITE_APP_CAPTCHA_ENABLE=false
VUE_APP_DOC_ENABLE=true
VUE_APP_BAIDU_CODE=fadc1bd5db1a1d6f581df60a1807f8ab

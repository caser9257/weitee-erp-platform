# LAN demo mode: frontend runs on this machine and other hosts access it by LAN IP.
NODE_ENV=development

VITE_DEV=true

# Backend base URL
VITE_BASE_URL='__AUTO__'

# Upload type: server or client (S3 only for client)
VITE_UPLOAD_TYPE=server

# API prefix
VITE_API_URL=/admin-api

# Debug options
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false

# Base path
VITE_BASE_PATH=/

# Related local service URLs
VITE_MALL_H5_DOMAIN='http://192.168.1.218:3000'
VITE_APP_CAPTCHA_ENABLE=false
VITE_GOVIEW_URL='http://192.168.1.218:3000'
